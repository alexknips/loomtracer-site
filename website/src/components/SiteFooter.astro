---
// The site footer of the landing page and the use cases page: the name and the links, then the
// founders with their GitHub profiles (src/data/founders.ts).
import { DEMO_URL } from '../data/demo';
import { founders } from '../data/founders';
const base = import.meta.env.BASE_URL;
---
<footer class="border-t border-border py-12">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="text-sm text-muted-foreground">
        Loomtracer &mdash; memory for decisions
      </div>
      <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-sm text-muted-foreground">
        <a href={`${base}getting-started/quickstart/`} class="hover:text-foreground transition-colors">Docs</a>
        <a href={DEMO_URL} class="hover:text-foreground transition-colors">Demo</a>
        <a href={`${base}use-cases/`} class="hover:text-foreground transition-colors">Use cases</a>
        <a href={`${base}pitch/`} class="hover:text-foreground transition-colors">Why Loomtracer</a>
        <a href="https://github.com/alexknips/loomtracer" class="hover:text-foreground transition-colors">GitHub</a>
      </div>
    </div>
    <div id="footer-contact" class="mt-8 pt-6 border-t border-border flex flex-col sm:flex-row items-center justify-between gap-x-6 gap-y-3 text-sm text-muted-foreground">
      <p>Contact the founders</p>
      <ul class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2">
        {founders.map((f) => (
          <li>
            <a href={`https://github.com/${f.github}`} class="font-medium text-foreground hover:text-link transition-colors">{f.name}</a>
            <span class="ml-1">{f.role}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</footer>
