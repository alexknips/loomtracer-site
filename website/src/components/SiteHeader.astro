---
// The site header of the landing page and the use cases page. The links to the
// landing page's sections carry the base path, so they work from either page.
// "Roadmap" is the use cases page's "Coming next" section (its three sections are
// works today, coming next, planned); the landing page keeps only a one-line summary.
import { DEMO_URL } from '../data/demo';
import logo from '../assets/logo-light.svg?raw';
const base = import.meta.env.BASE_URL;
// The logo inline, with its ink (the wordmark and one thread) in the text colour, so it turns
// ivory in dark mode; the blue, orange and yellow threads keep the brand's colours.
const logoSvg = logo
  .replaceAll('#332B32', 'currentColor')
  .replace('<svg ', '<svg class="h-8 w-auto" role="img" aria-label="Loomtracer" ');
---
<!-- Nav. From md up: the text links in a row. Below md: the wordmark, the
     Self-host button and a menu button; the menu (a <details>, so it works
     without JavaScript) lists every top-level page. The script below closes it
     after a tap on a link, on Escape and on a tap outside. -->
<header class="site-header sticky top-0 z-50 border-b border-border">
  <nav class="max-w-6xl mx-auto px-4 sm:px-6 min-h-16 py-3 flex flex-wrap items-center justify-between gap-x-6 gap-y-2" aria-label="Site">
    <!-- Loomtracer's logo: the mark and the wordmark (src/assets/logo-light.svg). -->
    <a href={base} class="flex items-center text-foreground"><Fragment set:html={logoSvg} /></a>
    <div class="flex items-center gap-x-5">
      <a href={`${base}getting-started/quickstart/`} class="hidden md:inline text-sm text-muted-foreground hover:text-foreground transition-colors">Docs</a>
      <a href={`${base}use-cases/#next`} class="hidden md:inline text-sm text-muted-foreground hover:text-foreground transition-colors">Roadmap</a>
      <a href={`${base}pitch/`} class="hidden md:inline text-sm text-muted-foreground hover:text-foreground transition-colors">Why Loomtracer</a>
      <a href={DEMO_URL} class="hidden md:inline text-sm text-muted-foreground hover:text-foreground transition-colors">Demo</a>
      <a href="https://github.com/alexknips/loomtracer" class="hidden md:inline text-sm text-muted-foreground hover:text-foreground transition-colors">GitHub</a>
      <a href={`${base}#self-host`} class="btn btn-primary">Self-host &rarr;</a>
      <details id="site-menu" class="group md:hidden -mr-2">
        <summary class="site-menu-toggle" aria-label="Menu">
          <!-- lucide "menu" when closed, lucide "x" when open -->
          <svg class="size-5 group-open:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
          <svg class="size-5 hidden group-open:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M18 6 6 18M6 6l12 12"/>
          </svg>
        </summary>
        <div class="site-menu-panel absolute inset-x-0 top-full border-b border-border bg-background shadow-md">
          <ul class="max-w-6xl mx-auto px-4 sm:px-6 py-2 divide-y divide-border text-md">
            <li><a href={`${base}getting-started/quickstart/`} class="block py-3 text-foreground hover:text-link">Docs</a></li>
            <li><a href={DEMO_URL} class="block py-3 text-foreground hover:text-link">Demo</a></li>
            <li><a href={`${base}use-cases/`} class="block py-3 text-foreground hover:text-link">Use cases</a></li>
            <li><a href={`${base}use-cases/#next`} class="block py-3 text-foreground hover:text-link">Roadmap</a></li>
            <li><a href={`${base}pitch/`} class="block py-3 text-foreground hover:text-link">Why Loomtracer</a></li>
            <li><a href="https://github.com/alexknips/loomtracer" class="block py-3 text-foreground hover:text-link">GitHub</a></li>
          </ul>
        </div>
      </details>
    </div>
  </nav>
</header>
<script>
  // Progressive enhancement for the phone menu (a <details>): close it after
  // a tap on one of its links (the in-page ones would otherwise leave it
  // covering the section), on Escape, and on a tap anywhere outside it.
  const menu = document.getElementById('site-menu') as HTMLDetailsElement | null;
  if (menu) {
    const close = () => menu.removeAttribute('open');
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', close));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && menu.open) close(); });
    document.addEventListener('click', (e) => {
      if (menu.open && e.target instanceof Node && !menu.contains(e.target)) close();
    });
  }
</script>
