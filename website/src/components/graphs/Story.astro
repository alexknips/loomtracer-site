---
// A story in one to three steps (before, what happened, after), each a small
// graph with a line under it. Side by side from lg, stacked below that, each
// frame capped so its words stay the size of the page's small text. A story of
// fewer than three steps keeps the three-column sizes and puts its key (the
// slot) in the next column. A one-step story has no step label: the title says it.
import Frame from './Frame.astro';
import type { Story } from '../../data/graph-stories';
import { DEMO_URL } from '../../data/demo';

interface Props {
  story: Story;
}

const { story } = Astro.props;
const n = story.steps.length;
const keyBeside = n < 3 && Astro.slots.has('default');
const span = n === 1 ? 'lg:col-span-1 lg:grid-cols-1' : 'lg:col-span-2 lg:grid-cols-2';
---
<figure class="mt-6 pt-6 border-t border-border min-w-0" aria-labelledby={`${story.id}-title`}>
  <figcaption id={`${story.id}-title`} class="text-xs font-mono uppercase tracking-wide text-muted-foreground mb-4">
    {story.title}
  </figcaption>
  <div class:list={['grid', keyBeside && 'lg:grid-cols-3 lg:gap-5']}>
    <ol class:list={['grid gap-7 lg:gap-5', keyBeside ? span : 'lg:grid-cols-3']}>
      {story.steps.map((step, i) => (
        <li class="min-w-0 max-w-[26rem] lg:max-w-none">
          {n > 1 && (
            <p class="text-xs font-mono text-muted-foreground mb-2">
              {i + 1} &middot; {step.label}
            </p>
          )}
          <Frame frame={step.frame} alt={step.alt} />
          <p class="text-sm text-muted-foreground leading-relaxed mt-3">{step.caption}</p>
        </li>
      ))}
    </ol>
    {keyBeside && <div class:list={['min-w-0', n > 1 && 'lg:pt-6']}><slot /></div>}
  </div>
  {!keyBeside && <slot />}
  {story.demo && (
    <p class="text-sm text-muted-foreground leading-relaxed mt-5">
      <a href={DEMO_URL} class="link">Try the demo &rarr;</a>
    </p>
  )}
</figure>
