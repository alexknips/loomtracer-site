---
// DRAFT concepts for slide 4 (Decision Metrics), for Alex to compare. Not linked from the deck;
// the live slide in pitch/index.astro is untouched. One route per concept, the slide alone on
// Jeff's 16:9 stage, in his type and palette. Who decided is colour (you orange, your agents
// blue); how much the record shows is weight (solid, partial, none, not assessed). No concept
// adds the seven up: each dimension stands alone, as docs/DECISION_SCORING.md requires.
import '@fontsource-variable/fraunces';
import '@fontsource-variable/source-sans-3';
import {
  counted,
  decisions,
  dimensions,
  profileCounts,
  typical,
  type Level,
  type Who,
} from '../../../data/seven-dimensions';

export function getStaticPaths() {
  return [
    { params: { concept: 'side-by-side' }, props: { n: 1, name: 'Side by side' } },
    { params: { concept: 'weave' }, props: { n: 2, name: 'The weave' } },
    { params: { concept: 'two-threads' }, props: { n: 3, name: 'Two threads' } },
    { params: { concept: 'impact-cards' }, props: { n: 4, name: 'Who held the big ones?' } },
  ];
}

const { concept } = Astro.params;
const { n, name } = Astro.props;
const title = `DRAFT ${n}/4 · ${name} · Loomtracer slide 4 concept`;
const levels: Level[] = ['solid', 'partial', 'none', 'na'];
const levelName: Record<Level, string> = { solid: 'solid', partial: 'partial', none: 'nothing on record', na: 'not assessed' };
const whoName: Record<Who, string> = { you: 'You', agent: 'Your agents' };
const total: Record<Who, number> = { you: counted.you, agent: counted.agent };
const pct = (who: Who, dim: string, l: Level) => ((profileCounts[dim][who][l] ?? 0) / total[who]) * 100;

// The weave: one warp thread per decision, one weft row per dimension.
function weave(wide: boolean) {
  const g = wide
    ? { w: 1000, labelW: 178, top: 46, rowH: 38, youX: 196, youStep: 13, gap: 30, agentStep: 15.6, labelsInline: true }
    : { w: 400, labelW: 0, top: 44, rowH: 54, youX: 8, youStep: 7.2, gap: 14, agentStep: 7.4, labelsInline: false };
  const you = decisions.filter((d) => d.who === 'you');
  const agent = decisions.filter((d) => d.who === 'agent');
  const agentX = g.youX + (you.length - 1) * g.youStep + g.gap;
  const cols = [
    ...you.map((d, i) => ({ ...d, x: g.youX + i * g.youStep })),
    ...agent.map((d, i) => ({ ...d, x: agentX + i * g.agentStep })),
  ];
  const rowY = (r: number) => g.top + r * g.rowH + (g.labelsInline ? g.rowH / 2 : 30);
  const h = g.top + dimensions.length * g.rowH + 8;
  return { g, cols, rowY, h, youEnd: g.youX + (you.length - 1) * g.youStep, agentX, agentEnd: cols[cols.length - 1].x };
}
const wW = weave(true);
const wN = weave(false);

// Two threads: a knot and seven threads fanning out to the seven names.
const fanY = (i: number) => 24 + i * 46;

// Who held the big ones? Illustrative decisions on an impact axis that is not built yet.
const cards: { title: string; who: Who; impact: number; levels: Level[]; flag?: boolean }[] = [
  { title: 'Rename the settings page', who: 'you', impact: 6, levels: ['none', 'none', 'partial', 'partial', 'na', 'none', 'na'] },
  { title: 'Log as JSON', who: 'agent', impact: 22, levels: ['none', 'solid', 'solid', 'partial', 'na', 'partial', 'na'] },
  { title: 'Retry a failed call 3 times', who: 'agent', impact: 42, levels: ['none', 'partial', 'solid', 'partial', 'na', 'partial', 'na'] },
  { title: 'Store data in Postgres', who: 'you', impact: 64, levels: ['partial', 'solid', 'solid', 'partial', 'na', 'partial', 'partial'] },
  { title: 'Drop the free plan', who: 'agent', impact: 86, levels: ['none', 'none', 'partial', 'partial', 'na', 'none', 'na'], flag: true },
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex,nofollow" />
  <meta name="color-scheme" content="light" />
  <title>{title}</title>
  <style is:global>
    :root{
      --ink:#332B32; --ivory:#FDF8F4; --blue:#1D90CD; --orange:#E25432; --yellow:#F3BA1E;
      --headline:'Fraunces Variable',serif; --body:'Source Sans 3 Variable',sans-serif;
      --hatch:repeating-linear-gradient(135deg,rgba(51,43,50,.38) 0 1.5px,transparent 1.5px 5px);
      color-scheme:light; font-family:var(--body); color:var(--ink); background:var(--ink);
    }
    *{box-sizing:border-box}
    html,body{margin:0;height:100%}
    body{display:grid;place-items:center;-webkit-font-smoothing:antialiased}
    h1,h2,h3,p{margin:0}
    h2{font-family:var(--headline);font-weight:600;line-height:1.09;letter-spacing:-.035em}
    .stage{position:relative;width:min(100vw,calc(100svh * 16 / 9));aspect-ratio:16/9;background:var(--ivory);container-type:inline-size;overflow:hidden}
    .slide{height:100%;padding:5.5cqw 6.25cqw 4.2cqw;display:flex;flex-direction:column}
    .eyebrow{font-size:1.18cqw;font-weight:600;line-height:1.25;letter-spacing:.1em;text-transform:uppercase;display:flex;justify-content:space-between}
    .eyebrow span::before{content:'';display:inline-block;width:2.1cqw;height:.24cqw;background:var(--orange);margin-right:.9cqw;vertical-align:middle}
    .draft{color:var(--orange)}
    .slide h2{font-size:3.2cqw;margin-top:1.3cqw}
    .body{flex:1;display:flex;flex-direction:column;justify-content:center;min-height:0}
    .foot{font-size:1.7cqw;line-height:1.3;border-top:1px solid var(--ink);padding-top:1.1cqw;display:flex;justify-content:space-between;gap:2cqw;align-items:baseline}
    .foot strong{font-weight:600}
    .src{font-size:1.05cqw;line-height:1.35;opacity:.8;text-align:right;max-width:38cqw}
    .you{--c:var(--orange)} .agent{--c:var(--blue)}
    .legend{display:flex;flex-wrap:wrap;gap:.6cqw 2cqw;font-size:1.25cqw;margin-top:1.3cqw}
    .legend span{display:inline-flex;align-items:center;gap:.6cqw}
    .sw{display:inline-block;width:2cqw;height:1.1cqw;border:1px solid var(--ink)}
    .sw.solid{background:var(--ink)} .sw.partial{background:rgba(51,43,50,.3)} .sw.none{background:transparent} .sw.na{background:var(--hatch)}

    /* 1 side by side: your decisions left, your agents' right, one row per dimension */
    .bfly{display:grid;grid-template-columns:1fr 17cqw 1fr;row-gap:.75cqw;align-items:center}
    .bfly .head{font-family:var(--headline);font-weight:600;font-size:2.1cqw;padding-bottom:.4cqw}
    .bfly .head.you{text-align:right;color:var(--orange)} .bfly .head.agent{color:var(--blue)}
    .bfly .head small{font-family:var(--body);font-weight:400;font-size:1.3cqw;color:var(--ink)}
    .bfly .dim{text-align:center;font-size:1.6cqw;font-weight:600;line-height:1.1}
    .bar{display:flex;height:2.7cqw;gap:.15cqw}
    .bar.you{flex-direction:row-reverse}
    .bar i{display:block;height:100%}
    .bar i.solid{background:var(--c)} .bar i.partial{background:color-mix(in srgb,var(--c) 32%,var(--ivory))}
    .bar i.none{background:transparent;box-shadow:inset 0 0 0 1.5px color-mix(in srgb,var(--c) 55%,var(--ivory))}
    .bar i.na{background:var(--hatch)}

    /* 2 the weave */
    .weave svg{display:block;width:100%;height:auto;font-family:var(--body);overflow:visible}
    .weave .narrow{display:none}
    .w-label{font-size:15px;font-weight:600;fill:var(--ink)}
    .w-head{font-family:var(--headline);font-weight:600;font-size:19px}
    .w-warp{stroke-width:1.3;opacity:.45}
    .w-weft{stroke:var(--ink);stroke-width:1;opacity:.12}
    .w-na{fill:none;stroke:rgba(51,43,50,.45);stroke-width:1.4;stroke-dasharray:1.6 2.2}

    /* 3 two threads */
    .pair{display:grid;grid-template-columns:1fr 1fr;gap:4cqw}
    .pair h3{font-family:var(--headline);font-weight:600;font-size:2.2cqw;line-height:1.1}
    .pair h3.you{color:var(--orange)} .pair h3.agent{color:var(--blue)}
    .pair .share{font-size:1.35cqw;margin-top:.35cqw}
    .pair svg{display:block;width:100%;height:auto;margin-top:.9cqw;font-family:var(--body);overflow:visible}
    .t-name{font-size:17px;font-weight:600;fill:var(--ink)}
    .t-level{font-size:14px;fill:var(--ink);opacity:.75}
    .t-na{stroke:rgba(51,43,50,.45) !important;stroke-dasharray:2 6;stroke-width:2.5 !important}

    /* 4 who held the big ones? */
    .board{display:grid;grid-template-columns:repeat(5,1fr);gap:1.4cqw;align-items:end;margin-top:.5cqw}
    .card{background:var(--ivory);border:1px solid var(--ink);border-top:.45cqw solid var(--c);padding:.9cqw 1cqw 1cqw}
    .card.flag{outline:.35cqw solid var(--yellow);outline-offset:.35cqw}
    .card .badge{font-size:1.05cqw;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--c)}
    .card h3{font-size:1.55cqw;font-weight:600;line-height:1.15;margin:.3cqw 0 .7cqw;min-height:3.6cqw}
    .strip{display:grid;grid-template-columns:repeat(7,1fr);gap:.2cqw}
    .strip i{display:block;height:1.4cqw}
    .strip i.solid{background:var(--c)} .strip i.partial{background:color-mix(in srgb,var(--c) 32%,var(--ivory))}
    .strip i.none{box-shadow:inset 0 0 0 1.5px color-mix(in srgb,var(--c) 55%,var(--ivory))} .strip i.na{background:var(--hatch)}
    .axis{grid-column:1/-1;display:flex;justify-content:space-between;align-items:center;border-top:2px dashed var(--ink);padding-top:.6cqw;margin-top:1.2cqw;font-size:1.25cqw}
    .axis .hi{font-weight:600}
    .axis .coming{background:var(--yellow);padding:.1cqw .6cqw;font-weight:600}
    .callout{font-size:1.45cqw;line-height:1.3;margin-top:.6cqw}
    .ill{display:inline-block;font-size:1cqw;font-weight:600;letter-spacing:.08em;text-transform:uppercase;border:1px solid var(--ink);padding:.1cqw .5cqw;margin-left:1cqw;vertical-align:middle}

    @media(max-width:760px){
      :root,html,body{height:auto;display:block;background:var(--ivory)}
      .stage{width:100%;aspect-ratio:auto;container-type:normal;overflow:visible}
      .slide{height:auto;padding:32px 20px 28px}
      .eyebrow{font-size:12px;letter-spacing:.06em;flex-wrap:wrap;gap:6px}
      .eyebrow span::before{width:22px;height:3px;margin-right:8px}
      .slide h2{font-size:32px;margin-top:16px}
      .body{margin:24px 0}
      .foot{font-size:18px;padding-top:14px;display:block}
      .src{font-size:13px;text-align:left;max-width:none;margin-top:10px}
      .legend{font-size:14px;gap:8px 16px;margin-top:16px}
      .sw{width:20px;height:12px}
      .bfly{grid-template-columns:1fr 92px 1fr;row-gap:8px}
      .bfly .head{font-size:18px}.bfly .head small{font-size:13px;display:block}
      .bfly .dim{font-size:13px}.bar{height:22px;gap:1px}
      .weave .wide{display:none}.weave .narrow{display:block}
      .pair{grid-template-columns:1fr;gap:28px}
      .pair h3{font-size:24px}.pair .share{font-size:15px}.pair svg{margin-top:10px}
      .board{grid-template-columns:1fr;gap:14px}
      .card{margin-bottom:0 !important;border-top-width:5px;padding:12px 14px}
      .card.flag{outline-width:4px;outline-offset:3px}
      .card .badge{font-size:12px}.card h3{font-size:19px;min-height:0;margin:4px 0 10px}
      .strip{gap:2px}.strip i{height:16px}
      .axis{font-size:14px;margin-top:14px;padding-top:8px;flex-wrap:wrap;gap:6px}.axis .coming{padding:2px 6px}
      .callout{font-size:17px;margin-top:12px}
      .ill{font-size:11px;padding:1px 5px;margin:6px 0 0;display:inline-block}
    }
  </style>
</head>
<body>
  <div class="stage" id="stage">
    <section class="slide" aria-label={`Concept ${n}: ${name}`}>
      <p class="eyebrow"><span>Decision Metrics</span><b class="draft">Draft concept {n} of 4 · {name}</b></p>
      <h2>Are you making the decisions that matter?</h2>

      <div class="body">
        {concept === 'side-by-side' && (
          <div>
            <div class="bfly" role="img" aria-label={`Our own project: for each of the seven dimensions, what the record shows for the ${counted.you} decisions a person made and the ${counted.agent} decisions agents made.`}>
              <p class="head you">You <small>{counted.you} decisions</small></p><span></span><p class="head agent">Your agents <small>{counted.agent} decisions</small></p>
              {dimensions.map((d) => (
                <>
                  <div class="bar you">{levels.map((l) => <i class={l} style={`width:${pct('you', d.id, l)}%`}></i>)}</div>
                  <p class="dim">{d.name}</p>
                  <div class="bar agent">{levels.map((l) => <i class={l} style={`width:${pct('agent', d.id, l)}%`}></i>)}</div>
                </>
              ))}
            </div>
            <p class="legend">{levels.map((l) => <span><i class={`sw ${l}`}></i>{levelName[l]}</span>)}<span>Each bar is all of that side's decisions.</span></p>
          </div>
        )}

        {concept === 'weave' && (
          <div class="weave">
            {[wW, wN].map((W, k) => (
              <svg class={k === 0 ? 'wide' : 'narrow'} viewBox={`0 0 ${W.g.w} ${W.h}`} role="img" aria-label={`Our own project as a weave: ${counted.you} threads for the decisions a person made, ${counted.agent} for the decisions agents made, crossed by the seven dimensions. A thick crossing is solid, a thin one partial, a gap is nothing on record, a dotted one not assessed.`}>
                <text class="w-head" x={W.g.youX} y="22" fill="var(--orange)">You · {counted.you}</text>
                <text class="w-head" x={W.agentX} y="22" fill="var(--blue)">Your agents · {counted.agent}</text>
                {dimensions.map((d, r) => (
                  <>
                    {W.g.labelsInline
                      ? <text class="w-label" x={W.g.labelW - 8} y={W.rowY(r) + 5} text-anchor="end">{d.name}</text>
                      : <text class="w-label" x={W.g.youX} y={W.rowY(r) - 14}>{d.name}</text>}
                    <line class="w-weft" x1={W.g.youX - 6} x2={W.agentEnd + 6} y1={W.rowY(r)} y2={W.rowY(r)} />
                  </>
                ))}
                {W.cols.map((c) => (
                  <g>
                    <line class="w-warp" stroke={c.who === 'you' ? 'var(--orange)' : 'var(--blue)'} x1={c.x} x2={c.x} y1={W.rowY(0) - 14} y2={W.rowY(dimensions.length - 1) + 14} />
                    {c.levels.map((l, r) =>
                      l === 'solid' ? <rect x={c.x - (W.g.labelsInline ? 5 : 3)} y={W.rowY(r) - 9} width={W.g.labelsInline ? 10 : 6} height="18" rx="1.5" fill={c.who === 'you' ? 'var(--orange)' : 'var(--blue)'} />
                      : l === 'partial' ? <rect x={c.x - (W.g.labelsInline ? 5 : 3)} y={W.rowY(r) - 3} width={W.g.labelsInline ? 10 : 6} height="6" rx="1" fill={c.who === 'you' ? 'var(--orange)' : 'var(--blue)'} />
                      : l === 'na' ? <line class="w-na" x1={c.x - 5} x2={c.x + 5} y1={W.rowY(r)} y2={W.rowY(r)} />
                      : <rect x={c.x - 2.5} y={W.rowY(r) - 6} width="5" height="12" fill="var(--ivory)" />,
                    )}
                  </g>
                ))}
              </svg>
            ))}
            <p class="legend"><span><i class="sw solid"></i>thick: solid</span><span><i class="sw partial"></i>thin: partial</span><span><i class="sw none"></i>gap: nothing on record</span><span><i class="sw na"></i>dotted: not assessed</span><span>One thread per decision.</span></p>
          </div>
        )}

        {concept === 'two-threads' && (
          <div class="pair">
            {(['you', 'agent'] as Who[]).map((who) => (
              <div class={who}>
                <h3 class={who}>{who === 'you' ? 'A typical decision of yours' : "A typical decision of your agents'"}</h3>
                <p class="share">{typical[who].share} of {total[who]} {who === 'you' ? 'decisions you made' : 'decisions your agents made'} look exactly like this</p>
                <svg viewBox="0 0 520 330" role="img" aria-label={`Seven threads from one knot, one per dimension: ${dimensions.map((d, i) => `${d.name} ${levelName[typical[who].levels[i]]}`).join(', ')}.`}>
                  {dimensions.map((d, i) => {
                    const l = typical[who].levels[i];
                    const c = who === 'you' ? 'var(--orange)' : 'var(--blue)';
                    const path = `M40 165 C 120 165, 140 ${fanY(i)}, 230 ${fanY(i)}`;
                    return (
                      <>
                        {l === 'none'
                          ? <><path d={`M40 165 C 70 165, 85 ${165 + (fanY(i) - 165) * 0.25}, 105 ${165 + (fanY(i) - 165) * 0.3}`} fill="none" stroke={c} stroke-width="2" /><line x1="200" x2="230" y1={fanY(i)} y2={fanY(i)} stroke={c} stroke-width="2" opacity=".5" /></>
                          : <path d={path} fill="none" stroke={c} stroke-width={l === 'solid' ? 9 : 2.5} stroke-linecap="round" class={l === 'na' ? 't-na' : ''} />}
                        <text class="t-name" x="246" y={fanY(i) + 6}>{d.name}</text>
                        <text class="t-level" x="420" y={fanY(i) + 6}>{levelName[l]}</text>
                      </>
                    );
                  })}
                  <circle cx="40" cy="165" r="16" fill={who === 'you' ? 'var(--orange)' : 'var(--blue)'} />
                </svg>
              </div>
            ))}
          </div>
        )}

        {concept === 'impact-cards' && (
          <div>
            <div class="board" role="img" aria-label="Illustrative: five made-up decisions along an impact axis that is not built yet. The one with the most impact, Drop the free plan, was decided by an agent on its own and has the thinnest record.">
              {cards.map((c, i) => (
                <div class:list={['card', c.who, c.flag && 'flag']} style={`margin-bottom:${i * 2.4}cqw`}>
                  <p class="badge">{c.who === 'you' ? 'You decided' : 'An agent decided'}</p>
                  <h3>{c.title}</h3>
                  <div class="strip">{c.levels.map((l) => <i class={l}></i>)}</div>
                </div>
              ))}
              <div class="axis"><span class="lo">less impact</span><span class="coming">Impact: coming</span><span class="hi">more impact →</span></div>
            </div>
            <p class="callout">The biggest call went to an agent, on the thinnest record. <span class="ill">Illustrative</span></p>
            <p class="legend"><span>Each strip: the seven dimensions, left to right</span>{levels.map((l) => <span><i class={`sw ${l}`}></i>{levelName[l]}</span>)}</p>
          </div>
        )}
      </div>

      <div class="foot">
        <p><strong>Today:</strong> a seven-dimension profile and who decided. <strong>Coming:</strong> which decisions carry the most impact.</p>
        <p class="src">{concept === 'impact-cards'
          ? 'Illustrative decisions and impact. The levels follow the real floors.'
          : `Real: our own project, ${counted.you + counted.agent} decisions, ${counted.at}. What the record shows, no model: Values needs a model, Calibration a declared confidence.`}</p>
      </div>
    </section>
  </div>
</body>
</html>
