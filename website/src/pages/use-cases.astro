---
// Use cases and roadmap: one card per thing Loomtracer does, marked works today,
// coming next or planned, with the command or tool call behind each one that
// works today. Since 2026-10-02 the one home for what comes next and what is
// planned: the landing page shows only what works today, and the drawings of
// the bet, the questions still waiting and the drifting projects moved here,
// each told once. Since v0.8.0 (2026-10-23) the bet and the questions work
// today; only the drifting projects carry planned parts. The same header, footer, cards and graphs as the landing
// page, on the app's design tokens. Every claim here is listed with its
// evidence in CLAIMS.md.
import '../styles/global.css';
import '../styles/graphs.css';
import SiteHeader from '../components/SiteHeader.astro';
import { DEMO_URL } from '../data/demo';
import SiteFooter from '../components/SiteFooter.astro';
import ThemeInit from '../components/ThemeInit.astro';
import Story from '../components/graphs/Story.astro';
import { storyBet, storyDrift, storyWaiting, type Story as StoryData } from '../data/graph-stories';
const base = import.meta.env.BASE_URL;

// A card's text is trusted HTML (bold, code and the command's parts); icon is
// the inside of a 24x24 lucide-style SVG. A card with a story spans the row.
type Card = {
  title: string;
  badge?: string;
  who?: string;
  body: string;
  cmd?: string;
  icon: string;
  story?: StoryData;
};

const today: Card[] = [
  {
    title: 'Record the decision as you work',
    who: 'Agent',
    body: 'Mid-task, your agent records the choice, the options it weighed and why, and what the decision rests on, without leaving the session. It records who decided: you, or the agent.',
    cmd: '<span class="font-medium">capture_decision</span><span class="text-muted-foreground">(title, rationale, options, chosen_option_label, grounding, decided_by)</span>',
    icon: '<path d="M13 3 4 14h6l-1 7 9-11h-6z"/>',
  },
  {
    title: 'Ask "why did we choose this?"',
    who: 'Human · Agent',
    body: 'In a fresh session, with no chat history: the rationale, the options chosen and rejected, who decided, and whether it still holds. Describe the decision; no id needed.',
    cmd: '<span class="text-muted-foreground">loomtracer query</span> <span class="font-medium">why</span> "sqlite for local storage"',
    icon: '<circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>',
  },
  {
    title: 'Ask "did it hold up?"',
    who: 'Human · Agent',
    body: 'Whether the decision still stands, or was replaced, disputed, or rests on a premise that no longer holds. With the reasons, from the record.',
    cmd: '<span class="text-muted-foreground">loomtracer query</span> <span class="font-medium">verify</span> "sqlite for local storage"',
    icon: '<path d="M20 6 9 17l-5-5"/>',
  },
  {
    title: 'Disagreement stays on the record',
    who: 'Human · Agent',
    body: 'Push back on a decision and both sides are kept. It reads <b class="font-semibold text-foreground">contested</b>, a state you can ask about, not a lost thread.',
    cmd: '<span class="text-muted-foreground">loomtracer</span> <span class="font-medium">disagree</span> "sqlite for local storage" --reason …',
    icon: '<path d="M4 8h13l-3-3m3 3-3 3"/><path d="M20 16H7l3-3m-3 3 3 3"/>',
  },
  {
    title: 'Replace without erasing',
    who: 'Human · Agent',
    body: 'Record the new decision as replacing the old one. The old one reads <b class="font-semibold text-foreground">superseded</b> and says what replaced it; the whole chain stays, and you can follow it back to the first proposal.',
    cmd: '<span class="text-muted-foreground">loomtracer</span> <span class="font-medium">supersede</span> "sqlite for local storage" --title … --rationale …',
    icon: '<path d="M4 7h9a4 4 0 0 1 4 4v0"/><path d="m14 4 3 3-3 3"/><path d="M20 17h-9a4 4 0 0 1-4-4v0"/><path d="m10 20-3-3 3-3"/>',
  },
  {
    title: 'Every decision says what it rests on',
    who: 'Human · Agent',
    body: 'An earlier decision, something observed, an assumption, or a bet with a date to check. When that premise is later replaced or refuted, the decisions built on it read <b class="font-semibold text-foreground">stale</b>. The capture plugin makes your agent answer this before it records: with nothing to go on, it records a bet, not made-up evidence, and asks you for the reason. A capture that names nothing is refused.',
    cmd: '<span class="text-muted-foreground">loomtracer emit decision.capture</span> … <span class="font-medium">--rests-on-decision</span> "ids never change"',
    icon: '<path d="M12 3v6"/><path d="M6 9h12"/><path d="M6 9v4M12 9v4M18 9v4"/><path d="M4 13h4M10 13h4M16 13h4"/><path d="M4 13l-1 4h6l-1-4M10 13l-1 4h6l-1-4M16 13l-1 4h6l-1-4"/>',
  },
  {
    title: '"What should I know before I touch this?"',
    who: 'Agent',
    body: 'The decisions about the files your agent is changing, read from the current diff. No question to type, and each one says whether it still holds.',
    cmd: '<span class="text-muted-foreground">loomtracer query</span> <span class="font-medium">situational</span>',
    icon: '<path d="M3 12s3.5-6 9-6 9 6 9 6-3.5 6-9 6-9-6-9-6Z"/><circle cx="12" cy="12" r="2.5"/>',
  },
  {
    title: 'Several projects, one record',
    who: 'Human · Agent',
    body: 'Every decision carries its project. A question asked from one project also looks in the project it is part of and the ones it depends on, one hop, and says where it stopped looking.',
    cmd: '<span class="text-muted-foreground">loomtracer query situational</span> <span class="font-medium">--project</span> mobile-client',
    icon: '<rect x="3" y="4" width="8" height="7" rx="1.5"/><rect x="13" y="4" width="8" height="7" rx="1.5"/><rect x="8" y="14" width="8" height="7" rx="1.5"/><path d="M7 11v3M17 11v3"/>',
  },
  {
    title: 'Look over a week of agent decisions',
    who: 'Human',
    body: 'What your agents decided this week, one by one: accept, dispute or replace each, in the terminal, without watching them live.',
    cmd: `<span class="text-muted-foreground">loomtracer</span> <span class="font-medium">review</span> --actor 'agent:*' --since 7d`,
    icon: '<rect x="4" y="5" width="16" height="16" rx="2"/><path d="M4 9h16M8 3v4M16 3v4"/><path d="M9 15l2 2 4-4"/>',
  },
  {
    title: 'The decision log as Markdown',
    who: 'Human',
    body: 'Export every decision as a tree of Markdown files grouped by project, an index first. Readable without Loomtracer, and it can live in your repo.',
    cmd: '<span class="text-muted-foreground">loomtracer</span> <span class="font-medium">export</span> --format markdown --out ./decisions/',
    icon: '<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/><path d="M12 11v6m-3-3 3 3 3-3"/>',
  },
  {
    title: 'Turn existing notes into decisions',
    who: 'Human',
    body: 'Import the <code class="code">Decision:</code> blocks from your docs. Each becomes a decision carrying its source, and lands as unreviewed until you look at it.',
    cmd: '<span class="text-muted-foreground">loomtracer</span> <span class="font-medium">import documents</span> ./notes/',
    icon: '<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/><path d="M9 13h6M9 16h4"/>',
  },
  {
    title: 'Import decisions from living documents',
    badge: 'Works today · experimental',
    who: 'Human',
    body: 'Pull decision candidates from a Google Doc or a file in git history. Each import records the source at the revision it read, so the citation stays honest as the document moves. Google Docs only; Confluence is not supported yet.',
    cmd: '<span class="text-muted-foreground">loomtracer</span> <span class="font-medium">import connector run</span> --url &lt;gdocs-url&gt;',
    icon: '<path d="M14 4H8a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V8z"/><path d="M14 4v4h4"/><path d="M9.5 14.5a2 2 0 0 1 2-2h1m1 4a2 2 0 0 1-2 2h-1"/><path d="M11 15h3"/>',
  },
  {
    title: 'A disagreement travels',
    who: 'Human · Agent',
    body: 'When a decision is replaced or disputed, every decision resting on it gets an open <b class="font-semibold text-foreground">re-examine</b> item, closed only by an explicit "still holds" or by its own replacement. The replaced decision shows how many of them are done, so a half-finished reversal is visible instead of quietly forgotten.',
    cmd: '<span class="text-muted-foreground">loomtracer</span> <span class="font-medium">reexamine</span>\n<span class="text-muted-foreground">loomtracer</span> <span class="font-medium">reaffirm</span> "cache records by id" --because …',
    icon: '<path d="M12 4v16"/><path d="M12 8l-5 3M12 8l5 3"/><circle cx="7" cy="13" r="2"/><circle cx="17" cy="13" r="2"/><path d="M7 15v4M17 15v4"/>',
  },
  {
    title: 'How well made was this decision?',
    who: 'Human · Agent',
    body: 'A profile on seven dimensions: framing, alternatives, information, reasoning, values and trade-offs, bias exposure, calibration. Each line names the recorded facts it was read from, and says "not assessed" where there is nothing to read. Not a grade, and never a mark against changing your mind.',
    cmd: '<span class="text-muted-foreground">loomtracer query</span> <span class="font-medium">score_decision</span> --id …',
    icon: '<path d="M4 20V10M10 20V4M16 20v-8M22 20H2"/>',
  },
  {
    title: 'An honest bet, called out',
    who: 'Human · Agent',
    body: 'With nothing yet to rest a decision on, name a bet and a date to check it. Calling it out is expected, not blame. Once the date passes, it is listed among what needs a look.',
    cmd: '<span class="text-muted-foreground">loomtracer query</span> <span class="font-medium">get_suggestions</span>',
    icon: '<path d="M12 3v3M12 18v3M3 12h3M18 12h3"/><circle cx="12" cy="12" r="5"/>',
    story: storyBet,
  },
  {
    title: 'Questions nobody has decided yet',
    who: 'Human · Agent',
    body: 'Ask a question before anything answers it, and it waits, with its age, until a decision answers it. What is contested and what changed are lists of their own.',
    cmd: '<span class="text-muted-foreground">loomtracer</span> <span class="font-medium">ask</span> "Open on Sundays?"\n<span class="text-muted-foreground">loomtracer query</span> <span class="font-medium">get_waiting_requests</span>',
    icon: '<circle cx="12" cy="12" r="9"/><path d="M9.5 9a2.5 2.5 0 1 1 3.5 2.3c-.6.3-1 .9-1 1.6v.6"/><path d="M12 17h.01"/>',
    story: storyWaiting,
  },
];

const next: Card[] = [
  {
    title: 'A much simpler, decision-first UI',
    body: "A list of decisions, newest first, as the start page, scoped by project. One decision's neighbourhood as the graph, with every arrow running from newer to older. Less clutter.",
    icon: '<rect x="3" y="4" width="18" height="14" rx="2"/><path d="M3 9h18M8 21h8"/><path d="M7 13h4M7 15.5h7"/>',
  },
  {
    title: 'Capture that runs all day',
    body: 'Your sessions with your agents are read as they happen and the decisions in them are recorded, with their options, reasons and who decided, so nobody has to say "record this". The pieces are in the current release; the setup that makes it one step is not.',
    icon: '<circle cx="12" cy="12" r="8"/><path d="M12 8v4l3 2"/>',
  },
];

const planned: Card[] = [
  {
    title: 'Speed, consistency and flexibility',
    body: 'Across your decisions with your agents: how fast you get from question to decision, how often a new decision agrees with the ones already in place, and how often you change your mind when evidence arrives. Shown side by side, never as one number, never as a ranking. A fast reversal on new evidence reads as a strength.',
    icon: '<path d="M3 20h18"/><path d="M5 16l4-5 4 3 6-8"/>',
  },
  {
    title: 'With and without Loomtracer, side by side',
    body: 'The same engineering task run twice by a coding agent: once with a hand-kept decisions file, once with Loomtracer. Recorded, reproducible, and the site will say what it shows and no more.',
    icon: '<rect x="3" y="5" width="8" height="14" rx="1.5"/><rect x="13" y="5" width="8" height="14" rx="1.5"/><path d="M5 9h4M5 12h4M15 9h4M15 12h4M15 15h2"/>',
  },
  {
    title: 'Two projects, drifting apart',
    body: 'Your agents work several projects, and one replaces a decision another rests on. Today the decision resting on it reads <b class="font-semibold text-foreground">stale</b>, also across linked projects, and "what should I know?" looks in the project it depends on. The drawing marks what is planned: catching a contradiction with <b class="font-semibold text-foreground">no recorded link</b>, and a count of the links that still hold.',
    icon: '<path d="M4 6h6c4 0 4 6 10 6"/><path d="M4 18h6c4 0 4-6 10-6"/><path d="m17 9 3 3-3 3"/>',
    story: storyDrift,
  },
];

const sections = [
  {
    id: 'today',
    title: 'What works today',
    tag: 'v0.8.0',
    tagClass: 'bg-success-soft text-success-foreground',
    note: 'Every write says who made it and is never edited or deleted. Status (proposed, accepted, contested, superseded) follows from the record, never from a label somebody sets by hand.',
    badge: 'Works today',
    badgeClass: 'bg-success-soft text-success-foreground',
    cardClass: 'border border-border bg-card shadow-xs',
    band: 'bg-sidebar',
    cards: today,
  },
  {
    id: 'next',
    title: 'Coming next',
    tag: 'Built, not yet released, or under way',
    tagClass: 'badge-warning',
    note: 'Merged and waiting for the next release, or being built now. Shown as intent until it is in a release you can install.',
    badge: 'Coming next',
    badgeClass: 'badge-warning',
    cardClass: 'border border-border bg-card shadow-xs',
    band: '',
    cards: next,
  },
  {
    id: 'planned',
    title: 'Planned',
    tag: 'Decided, not built',
    tagClass: 'badge-outline',
    note: 'On the roadmap, in the open. Shown here as intent, not as something that exists yet.',
    badge: 'Planned',
    badgeClass: 'badge-outline',
    cardClass: 'border border-dashed border-input',
    band: 'bg-sidebar',
    cards: planned,
  },
];
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Loomtracer — Use cases and roadmap</title>
  <meta name="description" content="Concrete ways one person and their agents use Loomtracer: record a decision with the options that lost, ask why later, keep disagreement, replace without erasing, see what a decision rests on. What works today in the current release, what is coming next, and what is planned." />
  <meta property="og:title" content="Loomtracer — use cases and roadmap" />
  <meta property="og:description" content="What Loomtracer does today for one person and their agents, what is coming next, and what is planned." />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={new URL(`${base}use-cases/`, Astro.site).href} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Loomtracer — use cases and roadmap" />
  <meta name="twitter:description" content="What Loomtracer does today, what is coming next, and what is planned." />
  <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
  <ThemeInit />
</head>
<body class="bg-background text-foreground antialiased">

  <SiteHeader />

  <main>

    <section class="max-w-6xl mx-auto px-4 sm:px-6 pt-16 sm:pt-24 pb-14 sm:pb-16">
      <p class="text-xs font-mono uppercase tracking-wide text-muted-foreground mb-3">Use cases and roadmap</p>
      <h1 class="text-2xl sm:text-3xl font-semibold tracking-tight text-foreground max-w-3xl mb-6">
        Point your coding agent at Loomtracer, <span class="text-muted-foreground">and it records the why as it works.</span>
      </h1>
      <p class="text-md sm:text-lg text-foreground max-w-2xl leading-relaxed mb-8">
        Concrete ways one person and their agents put Loomtracer to work: what works today, what is coming next,
        and what is planned. Every card for today shows the actual command of Loomtracer&rsquo;s command-line tool,
        <code class="code">loomtracer</code>, or the tool call; the drawings are made-up examples.
      </p>
      <!-- The legend: the site's only one, since the landing page shows only what works today. The second
           line is the key to the drawings' marks. -->
      <p class="text-sm text-muted-foreground flex flex-wrap gap-x-6 gap-y-2">
        <span class="inline-flex items-center gap-2"><span class="badge bg-success-soft text-success-foreground">Works today</span> in v0.8.0 (23 Oct 2026)</span>
        <span class="inline-flex items-center gap-2"><span class="badge badge-warning">Coming next</span> merged or under way, not yet released</span>
        <span class="inline-flex items-center gap-2"><span class="badge badge-outline">Planned</span> decided, not built</span>
      </p>
      <p class="text-sm text-muted-foreground flex flex-wrap items-center gap-x-5 gap-y-2 mt-3">
        <span>In the drawings:</span>
        <span class="inline-flex items-center gap-2"><span class="hg-key" aria-hidden="true"></span> works today</span>
        <span class="inline-flex items-center gap-2"><span class="hg-key hg-key--dashed" aria-hidden="true"></span><span class="font-mono text-2xs tracking-wide">PLANNED</span> not built</span>
      </p>
    </section>

    {sections.map((s) => (
      <section id={s.id} class:list={['border-t border-border scroll-mt-20', s.band]}>
        <div class="max-w-6xl mx-auto px-4 sm:px-6 py-16 sm:py-20">
          <div class="flex flex-wrap items-center gap-3 mb-3">
            <h2 class="text-xl font-semibold tracking-tight text-foreground">{s.title}</h2>
            <span class:list={['badge', s.tagClass]}>{s.tag}</span>
          </div>
          <p class="text-base text-muted-foreground leading-relaxed max-w-2xl mb-10" set:html={s.note} />
          <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
            {s.cards.map((c) => (
              <article class:list={['rounded-lg p-6 flex flex-col gap-3 min-w-0', s.cardClass, c.story && 'md:col-span-2 lg:col-span-3']}>
                <div class="flex items-center justify-between gap-3">
                  <span class="inline-flex size-9 shrink-0 items-center justify-center rounded-md bg-muted text-foreground">
                    <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={c.icon} />
                  </span>
                  <span class:list={['badge', s.badgeClass]}>{c.badge ?? s.badge}</span>
                </div>
                <h3 class="text-md font-semibold text-foreground">{c.title}</h3>
                {c.who && <p class="text-xs font-mono uppercase tracking-wide text-muted-foreground">{c.who}</p>}
                <p class:list={['text-base text-muted-foreground leading-relaxed flex-1', c.story && 'max-w-3xl']} set:html={c.body} />
                {c.cmd && <pre class="code-block px-3 py-2 break-normal break-words"><code set:html={c.cmd} /></pre>}
                {c.story && <Story story={c.story} />}
              </article>
            ))}
          </div>
        </div>
      </section>
    ))}

    <!-- Closing: as the landing page's "Start with one decision" -->
    <section id="start" class="border-t border-border">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 py-20 sm:py-24 text-center">
        <h2 class="text-xl font-semibold tracking-tight text-foreground mb-3">Start with one decision</h2>
        <p class="text-md text-muted-foreground mb-10 max-w-lg mx-auto">
          Point Claude Code, Codex or Cursor at your self-hosted Loomtracer, as a local binary or in a container.
        </p>
        <div class="flex flex-col sm:flex-row gap-3 justify-center">
          <a href={`${base}guides/mcp-setup/`} class="btn btn-primary btn-lg">
            Connect your agent &rarr;
          </a>
          <a href={DEMO_URL} class="btn btn-outline btn-lg">
            Open the demo &rarr;
          </a>
          <a href={`${base}getting-started/quickstart/`} class="btn btn-outline btn-lg">
            Read the docs
          </a>
        </div>
      </div>
    </section>

  </main>

  <SiteFooter />

</body>
</html>
